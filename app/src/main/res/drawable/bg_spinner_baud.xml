<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/card" />
            <stroke
                android:width="1dp"
                android:color="@color/line" />
            <corners android:radius="0dp" />
            <padding
                android:bottom="4dp"
                android:left="6dp"
                android:right="14dp"
                android:top="4dp" />
        </shape>
    </item>
    <item
        android:width="10dp"
        android:height="10dp"
        android:drawable="@drawable/ic_chevron"
        android:gravity="end|center_vertical"
        android:right="4dp" />
</layer-list>
