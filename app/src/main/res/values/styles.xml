<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ComTool" parent="android:Theme.Material.Light">
        <item name="android:colorPrimary">@color/card</item>
        <item name="android:colorPrimaryDark">@color/line</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/card</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:actionBarStyle">@style/Widget.ComTool.ActionBar</item>
        <item name="android:editTextStyle">@style/Widget.ComTool.EditText</item>
        <item name="android:checkboxStyle">@style/Widget.ComTool.CheckBox</item>
        <item name="android:radioButtonStyle">@style/Widget.ComTool.Radio</item>
        <item name="android:spinnerStyle">@style/Widget.ComTool.Spinner</item>
    </style>

    <style name="Widget.ComTool.ActionBar" parent="android:Widget.Material.Light.ActionBar.Solid">
        <item name="android:background">@color/card</item>
        <item name="android:elevation">1dp</item>
        <item name="android:titleTextStyle">@style/Text.ComTool.Title</item>
    </style>

    <style name="Text.ComTool.Title" parent="android:TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.ComTool.EditText" parent="android:Widget.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Widget.ComTool.CheckBox" parent="android:Widget.CompoundButton.CheckBox">
        <item name="android:buttonTint">@color/control_tint</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.ComTool.Radio" parent="android:Widget.CompoundButton.RadioButton">
        <item name="android:buttonTint">@color/control_tint</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.ComTool.Spinner" parent="android:Widget.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:popupBackground">@drawable/bg_card</item>
        <item name="android:minHeight">32dp</item>
    </style>

    <style name="Widget.ComTool.Button.Primary" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.ComTool.Button.Secondary" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.ComTool.Toggle" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_toggle</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textOn">开</item>
        <item name="android:textOff">关</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
